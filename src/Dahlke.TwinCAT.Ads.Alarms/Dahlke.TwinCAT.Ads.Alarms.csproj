<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- What differs per package; the rest is in src/Directory.Build.props -->
    <PackageId>Dahlke.TwinCAT.Ads.Alarms</PackageId>
    <!-- Temporary override while #47 lands project-by-project; consolidated back into
         src/Directory.Build.props once every package ports. -->
    <TargetFrameworks>net8.0;net9.0;net10.0;netstandard2.0</TargetFrameworks>
    <Description>PLC alarm tracking for Dahlke.TwinCAT.Ads — a live outstanding-alarm set and a raised/acknowledged/cleared/ended transition stream over a TwinCAT alarm array.</Description>
    <PackageTags>TwinCAT;ADS;Beckhoff;PLC;Automation;Alarms;Alarming</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dahlke.TwinCAT.Ads.Alarms.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Dahlke.TwinCAT.Ads/Dahlke.TwinCAT.Ads.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Versions and the reasoning behind their shape: src/Directory.Build.props -->
    <PackageReference Include="System.Reactive" Version="$(SystemReactiveVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- The netstandard2.0 compatibility set (#47): Polyfill is compile-time source only; the
         rest carry what the older BCL lacks — IAsyncEnumerable (the monitor's stream),
         ImmutableArray (the store), and System.Text.Json (the JSON text catalog; 8.0.5 floor,
         see root Directory.Build.props). -->
    <PackageReference Include="Polyfill" Version="$(PolyfillVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="$(MicrosoftBclAsyncInterfacesVersion)" />
    <PackageReference Include="System.Collections.Immutable" Version="$(SystemCollectionsImmutableVersion)" />
    <PackageReference Include="System.Text.Json" Version="$(SystemTextJsonVersion)" />
    <!-- PlcAlarmBinder's DLR fallback: the dynamic runtime binder is in-box on the modern
         frameworks and a package on netstandard2.0. -->
    <PackageReference Include="Microsoft.CSharp" Version="$(MicrosoftCSharpVersion)" />
  </ItemGroup>

</Project>
