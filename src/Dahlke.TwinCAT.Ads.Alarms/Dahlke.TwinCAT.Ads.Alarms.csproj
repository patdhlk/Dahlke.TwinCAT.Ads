<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      CS1574: some <see cref> doc comments forward-reference types that land in
      later tasks of this package's build-out (IAlarmTextCatalog in Task 6,
      PlcAlarmMonitor in Task 7). The plan's own text carries these crefs
      verbatim ahead of the types existing; suppressing here keeps the build
      warning-free without rewriting the doc prose. Safe to drop once every
      referenced type exists.
    -->
    <NoWarn>$(NoWarn);CS1574</NoWarn>

    <!-- NuGet Package Metadata -->
    <PackageId>Dahlke.TwinCAT.Ads.Alarms</PackageId>
    <Version>0.0.0-dev</Version>
    <Authors>Patrick Dahlke</Authors>
    <Description>PLC alarm tracking for Dahlke.TwinCAT.Ads — a live outstanding-alarm set and a raised/acknowledged/cleared/ended transition stream over a TwinCAT alarm array.</Description>
    <PackageTags>TwinCAT;ADS;Beckhoff;PLC;Automation;Alarms;Alarming</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/patdhlk/Dahlke.TwinCAT.Ads</PackageProjectUrl>
    <RepositoryUrl>https://github.com/patdhlk/Dahlke.TwinCAT.Ads.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dahlke.TwinCAT.Ads.Alarms.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Dahlke.TwinCAT.Ads/Dahlke.TwinCAT.Ads.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Reactive" Version="6.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.*" />
  </ItemGroup>

</Project>
