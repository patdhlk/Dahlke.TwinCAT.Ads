<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- What differs per package; the rest is in src/Directory.Build.props -->
    <PackageId>Dahlke.TwinCAT.Ads</PackageId>
    <Description>Reusable TwinCAT ADS connection pool with health checks, reconnection, simulation mode, and ASP.NET Core integration.</Description>
    <PackageTags>TwinCAT;ADS;Beckhoff;PLC;Automation;IPC</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dahlke.TwinCAT.Ads.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Bracketed rather than floating. "7.*" packs as an unbracketed minimum with NO upper bound,
      so a consumer restoring after Beckhoff ships 8.x silently gets it. The notification-payload
      decode reaches deep into public contract that a major version could reshape while preserving
      every signature: IValueRawSymbol.ValueAccessor -> ValueFactory -> CreateValue, plus Unwrap()
      and HasExternalDataReferences(). A change in readRaw's semantics there would produce silently
      WRONG VALUES with no compile error and no test failure — all hardware facts skip without a
      PLC, and the unit tests decode against stubs this library defines itself. The ceiling turns
      that into a restore-time failure a maintainer can evaluate deliberately.

      The Microsoft.Extensions references below are deliberately NOT bracketed, and that is a
      stated policy rather than an oversight: src/Directory.Build.props says why, and sets the
      per-target-framework version these resolve to.
    -->
    <PackageReference Include="Beckhoff.TwinCAT.Ads" Version="[7.0.292,8.0.0)" />
    <PackageReference Include="Beckhoff.TwinCAT.Ads.TcpRouter" Version="[7.0.292,8.0.0)" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

</Project>
