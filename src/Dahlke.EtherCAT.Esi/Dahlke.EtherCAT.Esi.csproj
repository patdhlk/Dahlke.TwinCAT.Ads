<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- What differs per package; the rest is in src/Directory.Build.props -->
    <PackageId>Dahlke.EtherCAT.Esi</PackageId>
    <Description>An EtherCAT Slave Information (ESI) device catalogue — parses vendor ESI XML into a queryable device set and resolves a vendor/product/revision triple to the best matching description. Depends on no ADS or TwinCAT package.</Description>
    <PackageTags>EtherCAT;ESI;Beckhoff;PLC;Automation;Fieldbus</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dahlke.EtherCAT.Esi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    This library deliberately depends on NOTHING but Microsoft.Extensions: ESI parsing is XML plus
    options and logging, with no ADS or Beckhoff concept in it. Adding an ADS dependency here would
    defeat the reason it is a separate package from Dahlke.EtherCAT.Diagnostics, which is the one
    that talks to a master over ADS.

    The per-target-framework version, and the reasoning behind its shape — fixed rather than
    floating, and unbracketed unlike Beckhoff's: the ROOT Directory.Build.props, not the one in
    src/ beside this file.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(MicrosoftExtensionsVersion)" />
  </ItemGroup>

</Project>
