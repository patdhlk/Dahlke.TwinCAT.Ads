                  <BitSize>32</BitSize>
                  <BitOffs>16</BitOffs>
                  <Flags>
                    <Access>rw</Access>
                  </Flags>
                </SubItem>
              </DataType>
              <!--
                Non-prefix truncation: <Info> names only the LAST of three declared members. A
                positional join reads info[0] as SubIndex 000's default and leaves Alpha/Beta
                without one; the name join must instead leave SubIndex 000 and Alpha untouched and
                give Beta the only default the file states.
              -->
              <DataType>
                <Name>DT1C13</Name>
                <BitSize>96</BitSize>
                <SubItem>
                  <SubIdx>0</SubIdx>
                  <Name>SubIndex 000</Name>
                  <Type>UDINT</Type>
                  <BitSize>8</BitSize>
                  <BitOffs>0</BitOffs>
                  <Flags>
                    <Access>ro</Access>
                  </Flags>
                </SubItem>
                <SubItem>
                  <SubIdx>1</SubIdx>
                  <Name>Alpha</Name>
                  <Type>UDINT</Type>
                  <BitSize>32</BitSize>
                  <BitOffs>16</BitOffs>
                  <Flags>
                    <Access>rw</Access>
                  </Flags>
                </SubItem>
                <SubItem>
                  <SubIdx>2</SubIdx>
                  <Name>Beta</Name>
                  <Type>UDINT</Type>
                  <BitSize>32</BitSize>
                  <BitOffs>48</BitOffs>
                  <Flags>
                    <Access>rw</Access>
                  </Flags>
                </SubItem>
              </DataType>
              <!--
                Duplicated name on the DECLARED side: both sub-items are named "Dup". <Info> names
                "Dup" once, but the name is ambiguous among the declared members, so neither may
                receive the default.
              -->
              <DataType>
                <Name>DT1C14</Name>
                <BitSize>64</BitSize>
                <SubItem>
                  <SubIdx>0</SubIdx>
                  <Name>Dup</Name>
                  <Type>UDINT</Type>
                  <BitSize>32</BitSize>
                  <BitOffs>0</BitOffs>
                  <Flags>
                    <Access>ro</Access>
                  </Flags>
                </SubItem>
                <SubItem>
                  <SubIdx>1</SubIdx>
                  <Name>Dup</Name>
                  <Type>UDINT</Type>
                  <BitSize>32</BitSize>
                  <BitOffs>32</BitOffs>
                  <Flags>
                    <Access>rw</Access>
                  </Flags>
                </SubItem>
              </DataType>
              <!--
                Duplicated name on the INFO side: "Gamma" is declared once, but <Info> lists it
                twice with two different defaults, so it is ambiguous which one applies and neither
                may be attached.
              -->
              <DataType>
                <Name>DT1C15</Name>
                <BitSize>64</BitSize>
                <SubItem>
                  <SubIdx>0</SubIdx>
                  <Name>Gamma</Name>
                  <Type>UDINT</Type>
                  <BitSize>32</BitSize>
