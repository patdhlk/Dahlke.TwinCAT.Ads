<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <!-- net48 resolves the libraries' netstandard2.0 legs and runs them on the .NET Framework
         runtime #47 exists for. Windows-only: the framework cannot execute elsewhere, and the
         ubuntu CI matrix must keep building without it. Compile-checking this leg from
         macOS/Linux works via -p:TargetFrameworks=net48 — the reference-assemblies package below
         makes that hermetic. -->
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net8.0;net9.0;net10.0;net48</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Explicit because the net48 leg would otherwise fall back to C# 7.3 — the modern TFMs
         already compile at this level via the SDK default. -->
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dahlke.TwinCAT.Ads.Testing\Dahlke.TwinCAT.Ads.Testing.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
