{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": ["**/*.csproj"]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net8.0"
      },
      "enumSortOrder": "declaringOrder"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.{md,yml}"],
        "exclude": ["_site/**", "superpowers/**", "obj/**"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "Dahlke.TwinCAT.Ads",
      "_appTitle": "Dahlke.TwinCAT.Ads",
      "_appFooter": "Dahlke.TwinCAT.Ads — Apache-2.0",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/patdhlk/Dahlke.TwinCAT.Ads",
        "branch": "main"
      }
    }
  }
}
